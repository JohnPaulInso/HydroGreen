{
  "name": "hydrotrack",
  "version": "1.0.0",
  "description": "A fully self-contained hydroponic tower manager. No build step, no internet connection required, no CDNs. Everything needed to run it is already inside this folder.",
  "main": "service-worker.js",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('www', {recursive:true, force:true}); fs.mkdirSync('www'); ['index.html','manifest.json','service-worker.js'].forEach(f=>fs.existsSync(f)&&fs.copyFileSync(f,'www/'+f)); ['css','js','assets'].forEach(d=>fs.existsSync(d)&&fs.cpSync(d,'www/'+d, {recursive:true}));\"",
    "sync": "npm run build && npx cap sync",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
